// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
  INACTIVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TravelStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum Action {
  READ
  WRITE
}

enum PermissionType {
  GRANT
  DENY
}

enum LivelihoodCategory {
  FARM
  NON_FARM
}

model Role {
  id                String           @id @default(uuid())
  name              String           @unique
  description       String?
  displayInRegister Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  users             User[]
  permissions       RolePermission[]
}

model User {
  id          String           @id @default(uuid())
  name        String
  username    String           @unique
  email       String           @unique
  password    String
  mobile      String?
  roleId      String
  status      UserStatus       @default(PENDING)
  department  String?
  leavesTaken Int              @default(0)
  leavesRemaining Int          @default(15)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  role        Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions UserPermission[]

  fellow             Fellow?
  leaves             Leave[]
  verifiedTransactions InventoryLedger[]
  attendanceLogs     AttendanceLog[]
  taskComments       FellowTaskComment[]
  travelRequests     TravelRequest[]
  approvedTravel     TravelRequest[]      @relation("ApprovedByUser")
  coachingRecords    CoachingRecord[]
  pmReflections      PMReflection[]
}

model Permission {
  id        String   @id @default(uuid())
  app       String
  page      String
  action    Action
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[]

  @@unique([app, page, action])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String         @id @default(uuid())
  userId       String
  permissionId String
  type         PermissionType @default(GRANT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model School {
  id            String          @id @default(uuid())
  name          String          @unique
  principalName String?
  udiseCode     String?
  email         String?
  phone         String?
  address       String?
  location      String?
  status        String          @default("Active")
  latitude      String?
  longitude     String?
  mapUrl        String?
  img           String?
  goal          Int             @default(80)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  fellows              FellowSchool[]
  students             Student[]
  programs             SchoolProgram[]
  learningAssessments  LearningAssessment[]
  homeworkRecords      StudentHomework[]
  assessmentForms      AssessmentForm[]
}

model Fellow {
  id                String          @id @default(uuid())
  name              String
  dob               DateTime?
  gender            String?
  email             String?         @unique
  phone             String?
  address           String?
  cohort            String
  avatar            String?
  progress          Int             @default(0)
  evaluationRating  Float?
  userId            String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User?           @relation(fields: [userId], references: [id])
  schools           FellowSchool[]
  students          Student[]
  goalSheets        GoalSheet[]
  reviews           FellowReview[]
  tasks             FellowTask[]
  coachingRecords   CoachingRecord[]
  assessmentForms   AssessmentForm[]
  engagementSurveys EngagementSurvey[]
  lookBeyondSurveys   LookBeyondSurvey[]
  pmReflections     PMReflection[]
}

model GoalSheet {
  id            String   @id @default(uuid())
  fellowId      String
  date          DateTime
  status        String   @default("SUBMITTED")  // SUBMITTED, REVIEWED
  portfolioLink String?
  responses     Json     @default("{}")     // JSONB for all Q1-Q13 answers
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fellow        Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
}

model PMReflection {
  id        String   @id @default(uuid())
  fellowId  String
  date      DateTime
  responses Json     @default("{}")  // { C1:"Novice", C2:"Beginner", ..., R5:"Advanced" }
  matrix    Json     @default("{}")  // { HS_HW:"#...", HS_LW:"#...", LS_HW:"#...", LS_LW:"#..." }
  notes     String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fellow    Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([fellowId])
}

model FellowReview {
  id           String    @id @default(uuid())
  fellowId     String
  period       String
  evaluation   String
  rating       Float?
  reviewerName String
  date         DateTime  @default(now())
  status       String    @default("Completed")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  fellow       Fellow    @relation(fields: [fellowId], references: [id], onDelete: Cascade)
}

model Student {
  id              String                 @id @default(uuid())
  studentId       String                 @unique
  name            String
  dob             DateTime?
  gender          String?
  email           String?
  phone           String?
  address         String?
  grade           String
  gradeGroup      String
  district        String?
  attendance      Float                  @default(0.0)
  guardianName    String?
  guardianPhone   String?
  enrolmentDate   DateTime?
  primaryLanguage String?
  status          String                 @default("On Track")
  schoolId        String?
  fellowId        String?
  beneficiaryId   String?
  isMigrated      Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  school          School?                @relation(fields: [schoolId], references: [id])
  fellow          Fellow?                @relation(fields: [fellowId], references: [id])
  beneficiary     Beneficiary?           @relation(fields: [beneficiaryId], references: [id])
  attendanceLogs      StudentAttendanceLog[]
  learningAssessments LearningAssessment[]
  homeworkRecords     StudentHomework[]
  transitions         StudentTransition[]
  assessmentForms     AssessmentForm[]
}

model StudentAttendanceLog {
  id         String   @id @default(uuid())
  studentId  String
  month      String
  present    Int
  total      Int
  percentage Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student    Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dayLogs    StudentAttendanceDayLog[]
}

model StudentAttendanceDayLog {
  id        String               @id @default(uuid())
  logId     String
  date      DateTime
  status    String               @default("Present") // Present, Absent, Late, Excused
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  log       StudentAttendanceLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@unique([logId, date])
}

model LearningAssessment {
  id        String   @id @default(uuid())
  studentId String
  schoolId  String
  date      DateTime
  canRead   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model StudentHomework {
  id             String   @id @default(uuid())
  studentId      String
  schoolId       String
  date           DateTime
  homeworkStatus String   @default("NOT_DONE") // DONE, NOT_DONE, NO_HOMEWORK
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model StudentTransition {
  id            String   @id @default(uuid())
  studentId     String
  academicYear  String
  month         String
  status        String   @default("CONTINUING_EDUCATION")
  description   String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model MigrationRecord {
  id                String      @id @default(uuid())
  beneficiaryId     String
  migrationType     String      @default("PERMANENT") // SEASONAL, PERMANENT
  destination       String
  migrationDate     DateTime
  expectedReturnDate DateTime?
  actualReturnDate  DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model IncomeRecord {
  id            String      @id @default(uuid())
  beneficiaryId String
  amount        Float
  incomeDate    DateTime
  source        String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model FellowSchool {
  id        String   @id @default(uuid())
  fellowId  String
  schoolId  String
  createdAt DateTime @default(now())

  fellow    Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([fellowId, schoolId])
}

model Program {
  id               String          @id @default(uuid())
  title            String
  description      String?
  duration         String?
  participantsText String?
  status           String          @default("Planning")
  icon             String?
  iconBg           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  schools          SchoolProgram[]
  events           ProgramEvent[]
}

model SchoolProgram {
  id        String  @id @default(uuid())
  schoolId  String
  programId String

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([schoolId, programId])
}

model ProgramEvent {
  id          String   @id @default(uuid())
  programId   String?
  title       String
  description String?
  date        DateTime
  location    String?
  status      String   @default("Scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program     Program? @relation(fields: [programId], references: [id])
}

model Beneficiary {
  id               String                 @id @default(uuid())
  enrolmentId      String                 @unique
  name             String
  dob              DateTime?
  panCard          String?
  aadhar           String?
  rationCard       String?
  mobNumber        String?
  resilienceScore  Int                    @default(50)
  annualIncome     Float?
  monthlyIncome    Float?
  caste            String?
  religion         String?
  address          String?
  householdSize    Int                    @default(4)
  primaryIncomeType String?
  tier             String                 @default("Tier 2")
  tierPercent      Int                    @default(50)
  bankName         String?
  bankAccountNo    String?
  bankIfsc         String?
  isMigrated       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  familyMembers     FamilyMember[]
  livestock         Livestock[]
  students          Student[]
  migrationRecords  MigrationRecord[]
  incomeRecords     IncomeRecord[]
  schemeEnrollments SchemeEnrollment[]
  goatRearingDetails BeneficiaryGoatRearing[]
  sugarcaneDetails           BeneficiarySugarcane[]
  livelihoodDetails  BeneficiaryLivelihood[]
  resilienceSurveys          ResilienceSurvey[]
  adaptiveCapacitySurveys    AdaptiveCapacitySurvey[]
  absorptiveCapacitySurveys  AbsorptiveCapacitySurvey[]
  transformativeSurveys      TransformativeCapacitySurvey[]
  vulnerabilitySurveys       VulnerabilitySurvey[]
  solutionPlans              SolutionPlan[]
}

model FamilyMember {
  id            String      @id @default(uuid())
  beneficiaryId String
  name          String
  relation      String
  dob           DateTime?
  contactInfo   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model Livestock {
  id            String                 @id @default(uuid())
  beneficiaryId String
  tagNumber     String                 @unique
  animalType    String
  breed         String?
  ageMonths     Int?
  healthStatus  String                 @default("Healthy")
  assignedAt    DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  beneficiary   Beneficiary            @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  healthLogs    LivestockHealthLog[]
}

model LivestockHealthLog {
  id          String    @id @default(uuid())
  livestockId String
  checkupDate DateTime  @default(now())
  status      String
  notes       String?
  performedBy String?
  createdAt   DateTime  @default(now())

  livestock   Livestock @relation(fields: [livestockId], references: [id], onDelete: Cascade)
}

model Scheme {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  enrollments SchemeEnrollment[]
}

model SchemeEnrollment {
  id            String      @id @default(uuid())
  beneficiaryId String
  schemeId      String
  enrolledAt    DateTime    @default(now())

  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  scheme        Scheme      @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([beneficiaryId, schemeId])
}

model BeneficiaryGoatRearing {
  id                   String              @id @default(uuid())
  beneficiaryId        String
  goatsAssigned        Int                 @default(0)
  investment           Float?
  returnsAmount        Float?
  roiPercentage        Float?
  advantagesLog        String?
  notes                String?
  goatRearingProgramId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  beneficiary          Beneficiary         @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  goatRearingProgram   GoatRearingProgram? @relation(fields: [goatRearingProgramId], references: [id], onDelete: SetNull)
  events               GoatRearingEvent[]
}

model GoatRearingProgram {
  id            String                    @id @default(uuid())
  name          String
  description   String?
  totalGoats    Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  beneficiaries BeneficiaryGoatRearing[]
}

model GoatRearingEvent {
  id                        String                  @id @default(uuid())
  beneficiaryGoatRearingId  String
  eventType                 String
  eventDate                 DateTime                @default(now())
  quantity                  Int                     @default(1)
  notes                     String?
  photoUrl                  String?
  recordedBy                String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  beneficiaryGoatRearing    BeneficiaryGoatRearing   @relation(fields: [beneficiaryGoatRearingId], references: [id], onDelete: Cascade)
}

model BeneficiarySugarcane {
  id                     String            @id @default(uuid())
  beneficiaryId          String
  hectaresAllotted       Float             @default(0.0)
  soilType               String?
  waterSource            String?
  cropStage              String            @default("Planting")
  estimatedYieldTons     Float             @default(0.0)
  actualYieldTons        Float?
  fertilizersDistributed String?
  estimatedRevenue       Float?
  actualRevenue          Float?
  sugarcaneProgramId     String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  beneficiary            Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  sugarcaneProgram       SugarcaneProgram? @relation(fields: [sugarcaneProgramId], references: [id], onDelete: SetNull)
}

model SugarcaneProgram {
  id                String                 @id @default(uuid())
  name              String
  description       String?
  totalLandHectares Float                  @default(0.0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  beneficiaries     BeneficiarySugarcane[]
}

model LivelihoodProgram {
  id            String              @id @default(uuid())
  category      LivelihoodCategory
  type          String
  name          String
  description   String?
  status        String              @default("active")
  totalTarget   Float?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  assignments   BeneficiaryLivelihood[]
}

model BeneficiaryLivelihood {
  id              String             @id @default(uuid())
  beneficiaryId   String
  programId       String
  attributes      Json
  notes           String?
  enrolledAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  beneficiary     Beneficiary        @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  program         LivelihoodProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  events          LivelihoodEvent[]

  @@index([beneficiaryId])
  @@index([programId])
}

model LivelihoodEvent {
  id              String                @id @default(uuid())
  livelihoodId    String
  eventType       String
  eventDate       DateTime              @default(now())
  quantity        Float?
  notes           String?
  photoUrl        String?
  recordedBy      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  livelihood      BeneficiaryLivelihood @relation(fields: [livelihoodId], references: [id], onDelete: Cascade)

  @@index([livelihoodId])
}

model DisasterIncident {
  id               String            @id @default(uuid())
  name             String
  location         String
  type             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  resourceNeeds    IncidentResourceNeed[]

  expectedFamiliesAffected Int @default(0)
  humanLossDied            Int @default(0)
  humanLossInjured         Int @default(0)
  humanLossMissing         Int @default(0)
  propertyLossEstimate     Float @default(0.0)
}

model HelpProvider {
  id             String                 @id @default(uuid())
  name           String                 @unique
  capabilityType String
  contactDetails String
  status         String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ResourceItem {
  id             String            @id @default(uuid())
  itemName       String            @unique
  availableStock Float             @default(0.0)
  unit           String
  status         String            @default("Optimal")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  ledgerTransactions InventoryLedger[]
  incidentNeeds      IncidentResourceNeed[]
}

model InventoryLedger {
  id                  String          @id @default(uuid())
  resourceItemId      String
  transactionType      String
  quantity            Float
  handledByUserId     String?
  incidentResourceNeedId String?
  notes               String?
  createdAt           DateTime        @default(now())

  resourceItem        ResourceItem    @relation(fields: [resourceItemId], references: [id], onDelete: Cascade)
  handledByUser       User?           @relation(fields: [handledByUserId], references: [id])
  incidentResourceNeed IncidentResourceNeed? @relation(fields: [incidentResourceNeedId], references: [id], onDelete: Cascade)
}

model AttendanceLog {
  id              String    @id @default(uuid())
  userId          String
  email           String?
  logdate         String?
  intimelog       String?
  outtimelog      String?
  workhours       String?
  workstatus      String?
  ef1             String?
  ef2             String?
  logininfo       String?
  logoutinfo      String?
  checkInLat      Float?
  checkInLng      Float?
  checkOutLat     Float?
  checkOutLng     Float?
  lessonPlanText  String?
  lessonPlanFiles Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Leave {
  id              String       @id @default(uuid())
  userId          String
  type            String?
  dates           String?
  reason          String?
  rejectionReason String?
  status          LeaveStatus  @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IncidentResourceNeed {
  id                String           @id @default(uuid())
  incidentId        String
  resourceItemId    String
  quantityNeeded    Float            @default(0.0)
  quantityReceived  Float            @default(0.0)
  transactionsCount Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  incident          DisasterIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resourceItem      ResourceItem     @relation(fields: [resourceItemId], references: [id], onDelete: Cascade)
  transactions      InventoryLedger[]
  
  @@unique([incidentId, resourceItemId])
}

model FellowTask {
  id             String    @id @default(uuid())
  fellowId       String
  title          String
  description    String?
  plannedDate    DateTime
  status         String    @default("Pending") // Pending, Completed
  isPlanned      Boolean   @default(true) // true if planned task, false if unplanned task
  completionDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  fellow      Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
  comments    FellowTaskComment[]
}

model FellowTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String   // User ID
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  task      FellowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ResilienceSurvey {
  id                        String      @id @default(uuid())
  beneficiaryId             String
  surveyDate                DateTime    @default(now())
  
  responses                 Json        
  
  lifeSatisfactionScore     Float       @default(0)
  planningScore             Float       @default(0)
  disasterReadinessScore    Float       @default(0)
  disasterBeliefsScore      Float       @default(0)
  disasterMindsetScore      Float       @default(0)
  financialResilienceScore  Float       @default(0)
  healthResilienceScore     Float       @default(0)
  socialConnectednessScore  Float       @default(0)
  socialProtectionScore     Float       @default(0)
  disasterWarningScore      Float       @default(0)
  vulnerabilityScore        Float       @default(0)
  
  overallScore              Float       @default(0)

  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  beneficiary               Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model AdaptiveCapacitySurvey {
  id                String      @id @default(uuid())
  beneficiaryId     String
  surveyDate        DateTime    @default(now())
  
  responses         Json        
  
  overallScore      Float       @default(0)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model AbsorptiveCapacitySurvey {
  id                String      @id @default(uuid())
  beneficiaryId     String
  surveyDate        DateTime    @default(now())
  
  responses         Json        
  
  overallScore      Float       @default(0)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model TransformativeCapacitySurvey {
  id                String      @id @default(uuid())
  beneficiaryId     String
  surveyDate        DateTime    @default(now())
  
  responses         Json        
  
  overallScore      Float       @default(0)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model VulnerabilitySurvey {
  id                String      @id @default(uuid())
  beneficiaryId     String
  surveyDate        DateTime    @default(now())
  
  responses         Json        

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model SolutionPlan {
  id                String      @id @default(uuid())
  beneficiaryId     String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  planData          Json        

  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
}

model CoachingRecord {
  id               String   @id @default(uuid())
  fellowId         String
  heading          String
  date             DateTime
  feedback         String?
  observationNotes String?
  fileUrl          String?
  authorId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fellow           Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
  author           User     @relation(fields: [authorId], references: [id])
}

model EngagementSurvey {
  id          String   @id @default(uuid())
  fellowId    String
  surveyDate  DateTime
  responses   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fellow      Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
}

model LookBeyondSurvey {
  id          String   @id @default(uuid())
  fellowId    String
  surveyDate  DateTime
  responses   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fellow      Fellow   @relation(fields: [fellowId], references: [id], onDelete: Cascade)
}

model TravelRequest {
  id               String       @id @default(uuid())
  userId           String
  destination      String
  purpose          String
  startDate        DateTime
  endDate          DateTime
  expectedExpenses Float
  status           TravelStatus @default(PENDING)
  rejectionReason  String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver         User?        @relation("ApprovedByUser", fields: [approvedBy], references: [id])
  expenses         TravelExpense[]
}

model TravelExpense {
  id               String        @id @default(uuid())
  travelRequestId  String
  actualExpense    Float
  expenseDetails   Json?
  receiptFiles     Json?
  notes            String?
  submittedAt      DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  travelRequest    TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
}

// ─── Assessment Templates (managed by ADMIN/PROGRAM_MANAGER) ───

model FLNCategory {
  id        String        @id @default(uuid())
  name      String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  questions FLNQuestion[]
}

model FLNQuestion {
  id           String      @id @default(uuid())
  categoryId   String
  questionText String
  marks        Float
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     FLNCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  responses    FLNResponse[]
}

model SELQuestion {
  id           String       @id @default(uuid())
  questionText String
  options      Json
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  responses    SELResponse[]
}

model SubjectAssessmentTemplate {
  id        String                     @id @default(uuid())
  name      String
  options   Json
  order     Int                        @default(0)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  responses SubjectAssessmentResponse[]
}

// ─── Assessment Form & Responses ───

model AssessmentForm {
  id                 String                      @id @default(uuid())
  studentId          String
  fellowId           String?
  schoolId           String?
  assessmentType     String
  date               DateTime
  isEnrolledInSchool Boolean?
  reasonNotEnrolled  String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  student            Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fellow             Fellow?                     @relation(fields: [fellowId], references: [id])
  school             School?                     @relation(fields: [schoolId], references: [id])
  enrollmentResponses EnrollmentResponse[]
  subjectResponses   SubjectAssessmentResponse[]
  flnResponses       FLNResponse[]
  selResponses       SELResponse[]
}

model EnrollmentResponse {
  id               String         @id @default(uuid())
  assessmentFormId String
  question         String
  answer           String
  createdAt        DateTime       @default(now())

  assessmentForm   AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Cascade)
}

model SubjectAssessmentResponse {
  id                String                    @id @default(uuid())
  assessmentFormId  String
  subjectTemplateId String
  selectedOption    String
  createdAt         DateTime                  @default(now())

  assessmentForm    AssessmentForm            @relation(fields: [assessmentFormId], references: [id], onDelete: Cascade)
  subjectTemplate   SubjectAssessmentTemplate @relation(fields: [subjectTemplateId], references: [id])

  @@unique([assessmentFormId, subjectTemplateId])
}

model FLNResponse {
  id               String         @id @default(uuid())
  assessmentFormId String
  flnQuestionId    String
  score            Float
  createdAt        DateTime       @default(now())

  assessmentForm   AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Cascade)
  flnQuestion      FLNQuestion    @relation(fields: [flnQuestionId], references: [id])

  @@unique([assessmentFormId, flnQuestionId])
}

model SELResponse {
  id               String         @id @default(uuid())
  assessmentFormId String
  selQuestionId    String
  answer           String
  createdAt        DateTime       @default(now())

  assessmentForm   AssessmentForm @relation(fields: [assessmentFormId], references: [id], onDelete: Cascade)
  selQuestion      SELQuestion    @relation(fields: [selQuestionId], references: [id])

  @@unique([assessmentFormId, selQuestionId])
}
